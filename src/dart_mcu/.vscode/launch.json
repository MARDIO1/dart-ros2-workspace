{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug: OpenOCD ST-LINK",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/dart_mcu.elf",
            "device": "STM32F427IIHx",
            "preLaunchTask": "CMake: Build",
            "runToEntryPoint": "main",
            "serverpath": "T:/SDK/OPENOCD/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "gdbPath": "T:/SDK/STM32CubeCLT_1.20.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                "T:/SDK/OPENOCD/xpack-openocd-0.12.0-7/openocd/scripts"
            ],
            "configFiles": [
                "${workspaceFolder}/stlink.cfg"
            ],
            "showDevDebugOutput": "raw",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "Cortex-Debug: OpenOCD ST-LINK Attach",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/dart_mcu.elf",
            "device": "STM32F427IIHx",
            "runToEntryPoint": "main",
            "serverpath": "T:/SDK/OPENOCD/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "gdbPath": "T:/SDK/STM32CubeCLT_1.20.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                "T:/SDK/OPENOCD/xpack-openocd-0.12.0-7/openocd/scripts"
            ],
            "configFiles": [
                "${workspaceFolder}/stlink.cfg"
            ],
            "showDevDebugOutput": "raw",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}