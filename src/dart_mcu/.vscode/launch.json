{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug: OpenOCD ST-LINK",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/dart_mcu.elf",
            "device": "STM32F427IIHx",
            "preLaunchTask": "CMake: Build",
            "runToEntryPoint": "main",
            "serverpath": "D:/DevEnv/Debuggers/OpenOCD/bin/openocd.exe",
            "gdbPath": "D:/DevEnv/Compilers/ARM-GCC/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                "D:/DevEnv/Debuggers/OpenOCD/share/openocd/scripts"
            ],
            "configFiles": [
                "${workspaceFolder}/stlink.cfg"
            ],
            "showDevDebugOutput": "raw",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "gdbServerArgs": "",
            "overrideGDBServerPort": false,
            "preRestartCommands": [],
            "postRestartCommands": []
        },
        {
            "name": "Cortex-Debug: OpenOCD ST-LINK Attach",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/dart_mcu.elf",
            "device": "STM32F427IIHx",
            "runToEntryPoint": "main",
            "serverpath": "D:/DevEnv/Debuggers/OpenOCD/bin/openocd.exe",
            "gdbPath": "D:/DevEnv/Compilers/ARM-GCC/bin/arm-none-eabi-gdb.exe",
            "searchDir": [
                "D:/DevEnv/Debuggers/OpenOCD/share/openocd/scripts"
            ],
            "configFiles": [
                "${workspaceFolder}/stlink.cfg"
            ],
            "showDevDebugOutput": "raw",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "gdbServerArgs": "",
            "overrideGDBServerPort": false,
            "preRestartCommands": [],
            "postRestartCommands": []
        }
    ]
}
